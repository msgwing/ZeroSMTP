<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>zerosmtp-cs</AssemblyName>
    <RootNamespace>ZeroSMTPExample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.16.0+ required: fixes CVE-2026-41319 (STARTTLS response injection / SASL downgrade) -->
    <PackageReference Include="MailKit" Version="4.17.0" />
  </ItemGroup>

</Project>
