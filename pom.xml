<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.zerosmtp</groupId>
  <artifactId>zerosmtp-java</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <exec.mainClass>ZeroSMTPMailer</exec.mainClass>
  </properties>

  <!--
    java-zerosmtp.java targets recent JDK preview features (virtual threads,
    pattern matching for switch) that are stable as of JDK 21 LTS. Set
    maven.compiler.release higher if you want to target a newer JDK you have
    installed.
  -->

  <dependencies>
    <!-- Jakarta Mail API + the Eclipse Angus reference implementation
         (successor to the old com.sun.mail:javax.mail / jakarta.mail
         coordinates after Jakarta EE moved to the Eclipse Foundation). -->
    <dependency>
      <groupId>jakarta.mail</groupId>
      <artifactId>jakarta.mail-api</artifactId>
      <version>2.1.3</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.angus</groupId>
      <artifactId>angus-mail</artifactId>
      <version>2.0.5</version>
    </dependency>
  </dependencies>

  <build>
    <!-- This repo keeps one file per language at the project root instead
         of the standard src/main/java layout, so point Maven at it directly. -->
    <sourceDirectory>.</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <includes>
            <include>java-zerosmtp.java</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <mainClass>${exec.mainClass}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
